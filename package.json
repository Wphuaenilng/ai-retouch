{
  "name": "retouch-studio",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @retouch/server --filter @retouch/web dev",
    "dev:server": "pnpm --filter @retouch/server dev",
    "dev:web": "pnpm --filter @retouch/web dev",
    "db:migrate": "pnpm --filter @retouch/server db:migrate",
    "db:seed": "pnpm --filter @retouch/server db:seed",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"apps/**/*.ts\" \"apps/**/*.tsx\" \"packages/**/*.ts\"",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "verify": "pnpm typecheck && pnpm format:check && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.70.1"
  }
}
