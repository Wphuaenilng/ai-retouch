{
  "name": "@retouch/server",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "smoke": "tsx --env-file-if-exists=../../.env scripts/smoke.ts",
    "cost-report": "tsx --env-file-if-exists=../../.env scripts/cost-report.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.0",
    "@retouch/shared": "workspace:*",
    "fastify": "^5.0.0",
    "jose": "^5.9.0",
    "tsx": "^4.19.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
